{
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "decision_id",
    "outcome",
    "parent_problem_ref",
    "natural_gate_0_ref",
    "retained_problem",
    "reason",
    "functional_collision_work_refs",
    "exclusion_basis",
    "evidence_refs"
  ],
  "properties": {
    "schema_id": {
      "const": "importance-decision"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "CONCURRENT",
        "REROUTE",
        "KILL"
      ]
    },
    "parent_problem_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "natural_gate_0_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "candidate_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "collision_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "retained_problem": {
      "type": "object",
      "required": [
        "natural_failure",
        "population_id",
        "endpoint",
        "strong_simple_alternative",
        "falsifiable_prediction"
      ],
      "properties": {
        "natural_failure": {
          "type": "string",
          "minLength": 1
        },
        "population_id": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "strong_simple_alternative": {
          "type": "string",
          "minLength": 1
        },
        "falsifiable_prediction": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "functional_collision_work_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "exclusion_basis": {
      "type": "array",
      "items": {
        "enum": [
          "first_subdomain_use",
          "extra_memory_type",
          "higher_order_only",
          "schema_model_or_benchmark_only"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
