{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/authority-request/1.0.0",
  "title": "authority-request",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "operation_id",
    "action",
    "account_identity",
    "target",
    "revision_precondition",
    "asset_scope",
    "path_scope",
    "destination_service",
    "purpose",
    "effect_digest",
    "budget",
    "persistence",
    "expires_at"
  ],
  "properties": {
    "schema_id": {
      "const": "authority-request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "effect_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "account_identity": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "destination_service": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object"
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "revision_precondition": {
      "type": "string",
      "minLength": 1
    },
    "asset_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "path_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "persistence": {
      "enum": [
        "once"
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
