{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/research-intake/1.0.0",
  "title": "research-intake",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "project",
    "entry_inference",
    "assets",
    "sources"
  ],
  "properties": {
    "schema_id": {
      "const": "research-intake"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "one_sentence_goal",
        "operating_mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "one_sentence_goal": {
          "type": "string",
          "minLength": 1
        },
        "operating_mode": {
          "enum": [
            "audit",
            "plan",
            "implement",
            "run",
            "full"
          ]
        }
      }
    },
    "entry_inference": {
      "type": "object",
      "required": [
        "value",
        "status",
        "basis"
      ],
      "properties": {
        "value": {
          "enum": [
            "I",
            "M",
            "R",
            "mixed",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "provisional",
            "confirmed"
          ]
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assets": {
      "type": "object"
    },
    "sources": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
